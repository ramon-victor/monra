# Generated automatically by: ./monra install
MONRA_BIND_IP=127.0.0.1
MONRA_PORT=5522
MONRA_PUBLIC_URL=http://localhost:5522
MONRA_TRUSTED_ORIGINS=http://localhost:5522
MONRA_ENABLE_HTTPS=false
MONRA_DOMAIN=
MONRA_ACME_EMAIL=

# Replace every value below with an independent random value.
MONRA_POSTGRES_ADMIN_PASSWORD=replace-with-random-value
MONRA_STUDIO_DB_PASSWORD=replace-with-random-value
MONRA_WA_DB_PASSWORD=replace-with-random-value
MONRA_VALKEY_PASSWORD=replace-with-random-value
MONRA_AUTH_SECRET=replace-with-random-value
MONRA_WA_API_KEY=replace-with-random-value
MONRA_WEBHOOK_SECRET=replace-with-random-value

MONRA_SAVE_MESSAGES=false
MONRA_WEBHOOK_FILES=true
MONRA_CONNECT_ON_STARTUP=true
MONRA_WA_LOG_LEVEL=INFO
MONRA_IGNORE_GROUP_EVENTS=false
MONRA_IGNORE_STATUS_EVENTS=true
MONRA_STUDIO_DEBUG=false

# Optional AI providers. Leave blank until you intentionally configure one.
AI_GATEWAY_API_KEY=
OPENCODE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
CHAT_AGENT_MODEL=gemini-cli/gemini-3-flash-preview
CHAT_AGENT_MODEL_MAX_RETRIES=3
